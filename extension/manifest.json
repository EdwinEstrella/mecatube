{
  "manifest_version": 3,
  "name": "Mecatube Bridge",
  "version": "0.3.0",
  "description": "Relays Mecatube prompts to chat.deepseek.com and Google Flow, and returns the replies and generated images.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mecatube Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "debugger"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://flow.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["flow.js"],
      "run_at": "document_idle"
    }
  ]
}
